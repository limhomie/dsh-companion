{
  "name": "dsh-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "android:apk": "pnpm run verify:harness && pnpm --filter @dsh-companion/android apk:debug",
    "android:open": "pnpm --filter @dsh-companion/android open",
    "android:release": "pnpm run verify:harness && pnpm --filter @dsh-companion/android apk:release",
    "android:sync": "pnpm run verify:harness && pnpm --filter @dsh-companion/android sync",
    "build": "pnpm run verify:harness && pnpm --filter @dsh-companion/web build",
    "build:native": "pnpm run verify:harness && pnpm --filter @dsh-companion/web build:native",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "dev": "pnpm run verify:harness && pnpm --filter @dsh-companion/web dev --host 127.0.0.1",
    "host": "pnpm run build && node scripts/start-harness.mjs",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:web": "pnpm run build && pnpm run build:native && playwright test",
    "typecheck": "pnpm run verify:harness && tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/host-web/tsconfig.json",
    "verify:harness": "node scripts/verify-harness.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0",
    "typescript": "6.0.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.8"
  }
}
