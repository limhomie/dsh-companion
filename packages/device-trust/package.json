{
  "name": "@dsh-companion/device-trust",
  "description": "Paired-device trust Service Definition for DSH Companion",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "README.md"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-action-source": "0.1.0-rc.5",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-action-source": "0.1.0-rc.5",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.5"
  }
}
