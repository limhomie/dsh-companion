{
  "name": "@dsh-companion/device-trust-local",
  "description": "Storage-domain-backed paired-device trust Provider for DSH Companion",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "README.md"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@dsh-companion/device-trust": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.5"
  }
}
